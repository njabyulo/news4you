{
  "name": "@news4you/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsx scripts/render-explained.tsx && vite build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "deploy": "wrangler deploy",
    "diagram:render": "tsx scripts/render-explained.tsx"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@news4you/core": "workspace:*",
    "@news4you/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "wrangler": "4.152.0"
  }
}
